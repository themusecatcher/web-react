// 应用配置（浏览器环境配置）
{
  "include": [
    "src/**/*",
    "src/**/*.ts",
    "src/**/*.tsx",
    "types/**/*.d.ts",
    "build/*.ts",
    "build/**/*.ts",
    "mock/**/*.ts",
    "*.d.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "removeComments": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "typeRoots": [
      "./node_modules/@types/",
      "./types"
    ],
    "paths": {
      "@/*": ["./src/*"],
      "#/*": ["./types/*"],
      "apis/*": ["./src/apis/*"],
      "images/*": ["./src/assets/images/*"],
      "less/*": ["./src/assets/less/*"],
      "sass/*": ["./src/assets/sass/*"],
      "components/*": ["./src/components/*"],
      "enums/*": ["./src/enums/*"],
      "hooks/*": ["./src/hooks/*"],
      "http/*": ["./src/http/*"],
      "stores/*": ["./src/stores/*"],
      "utils/*": ["./src/utils/*"]
    }
  }
}
